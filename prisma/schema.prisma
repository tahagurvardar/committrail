generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum GitHubConnectionStage {
  INSTALLATION
  AUTHORIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

enum RepositorySource {
  PUBLIC
  INSTALLATION
}

enum TrackingStatus {
  ACTIVE
  INACCESSIBLE
  DISCONNECTED
}

enum SyncMode {
  INITIAL
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum WebhookDeliveryStatus {
  RECEIVED
  QUEUED
  IGNORED
  PROCESSED
  FAILED
}

enum IngestionJobKind {
  REPOSITORY_METADATA
  COMMITS
  PULL_REQUESTS
  ISSUES
  RELEASES
  WORKFLOW_RUNS
  INSTALLATION_STATE
  INSTALLATION_REPOSITORIES
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum ObservationSourceKind {
  MANUAL_SYNC
  WEBHOOK
}

enum EvidenceSourceAvailability {
  AVAILABLE
  UNAVAILABLE
  DELETED
}

enum ClaimStatus {
  DRAFT
  NEEDS_EVIDENCE
  VERIFIED
  ARCHIVED
}

enum ClaimRevisionKind {
  CREATED
  STATEMENT_EDITED
  STATUS_CHANGED
  EVIDENCE_LINKED
  EVIDENCE_UNLINKED
  VERIFIED
  ARCHIVED
  RESTORED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedWorkspace Workspace? @relation("WorkspaceOwner")
  memberships   WorkspaceMember[]
  connectionAttempts GitHubConnectionAttempt[]
  initiatedSyncRuns RepositorySyncRun[]
  auditEvents   AuditEvent[]
  authoredClaims EvidenceClaim[]
  linkedClaimEvidence ClaimEvidence[]
  claimRevisions ClaimRevision[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  ownerUserId  String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  connectionAttempts GitHubConnectionAttempt[]
  installations GitHubInstallation[]
  trackedRepositories TrackedRepository[]
  auditEvents  AuditEvent[]
  webhookDeliveries WebhookDelivery[]
  ingestionJobs IngestionJob[]
  evidenceClaims EvidenceClaim[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model GitHubConnectionAttempt {
  id                    String @id @default(cuid())
  workspaceId           String
  initiatingUserId      String
  stage                 GitHubConnectionStage
  stateHash             String @unique
  encryptedPkceVerifier String?
  pendingInstallationId BigInt?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime @default(now())
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiatingUser        User @relation(fields: [initiatingUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([initiatingUserId])
}

model GitHubInstallation {
  id                    String @id @default(cuid())
  workspaceId           String
  installationId        BigInt @unique
  accountId             BigInt
  accountLogin          String
  accountType           String
  repositorySelection   RepositorySelection
  permissions           Json
  suspendedAt           DateTime?
  verifiedAt            DateTime
  lastRepositoryDiscoveryAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories          TrackedRepository[]
  webhookDeliveries     WebhookDelivery[]
  ingestionJobs         IngestionJob[]

  @@index([workspaceId])
}

model TrackedRepository {
  id                    String @id @default(cuid())
  workspaceId           String
  githubInstallationId  String?
  githubRepositoryId    BigInt
  ownerLogin            String
  name                  String
  fullName              String
  visibility            String
  defaultBranch         String
  archived              Boolean @default(false)
  fork                  Boolean @default(false)
  sourceType            RepositorySource
  trackingStatus        TrackingStatus @default(ACTIVE)
  lastSuccessfulSyncAt  DateTime?
  latestSyncStatus      SyncStatus?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation          GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  snapshot              RepositorySnapshot?
  evidence              RepositoryEvidence[]
  syncRuns              RepositorySyncRun[]
  webhookDeliveries     WebhookDelivery[]
  ingestionJobs         IngestionJob[]
  ingestionCursors      RepositoryIngestionCursor[]
  evidenceClaims        EvidenceClaim[]

  @@unique([workspaceId, githubRepositoryId])
  @@index([githubInstallationId])
}

model RepositorySnapshot {
  id                    String @id @default(cuid())
  trackedRepositoryId   String @unique
  normalizedData        Json
  sourceUpdatedAt       DateTime
  sourcePushedAt        DateTime?
  fetchedAt             DateTime
  schemaVersion         Int @default(1)
  trackedRepository     TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
}

model RepositoryEvidence {
  id                    String @id @default(cuid())
  trackedRepositoryId   String
  evidenceId            String
  evidenceType          String
  githubSourceId        String
  canonicalUrl          String
  occurredAt            DateTime
  title                 String
  sourceLabel           String @default("GitHub")
  confidence            String @default("fact")
  factualPayload        Json
  normalizedContentHash String @default("")
  sourceAvailability    EvidenceSourceAvailability @default(AVAILABLE)
  sourceUnavailableAt   DateTime?
  firstSeenAt           DateTime @default(now())
  lastSeenAt            DateTime @default(now())
  trackedRepository     TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  observations          EvidenceObservation[]
  claimLinks            ClaimEvidence[]

  @@unique([trackedRepositoryId, evidenceId])
  @@unique([id, trackedRepositoryId])
  @@index([trackedRepositoryId, occurredAt])
  @@index([trackedRepositoryId, evidenceType, sourceAvailability])
}

model RepositorySyncRun {
  id                    String @id @default(cuid())
  trackedRepositoryId   String
  initiatingUserId      String
  mode                  SyncMode
  status                SyncStatus
  startedAt             DateTime @default(now())
  completedAt           DateTime?
  sanitizedErrorCode    String?
  insertedCount         Int @default(0)
  updatedCount          Int @default(0)
  seenCount             Int @default(0)
  sectionAvailability   Json?
  createdAt             DateTime @default(now())
  trackedRepository     TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  initiatingUser        User @relation(fields: [initiatingUserId], references: [id], onDelete: Cascade)
  observations          EvidenceObservation[]

  @@index([trackedRepositoryId, status, createdAt])
  @@index([initiatingUserId])
}

model WebhookDelivery {
  id                    String @id @default(cuid())
  githubDeliveryId      String @unique
  workspaceId           String?
  githubInstallationId  String?
  trackedRepositoryId   String?
  ingestionJobId        String?
  jobGeneration         Int @default(0)
  eventName             String
  action                String?
  installationId        BigInt?
  githubRepositoryId    BigInt?
  payloadSha256         String
  bodyByteCount         Int
  duplicateCount        Int @default(0)
  receivedAt            DateTime @default(now())
  status                WebhookDeliveryStatus @default(RECEIVED)
  ignoredReason         String?
  processedAt           DateTime?
  sanitizedErrorCode    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation          GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  trackedRepository     TrackedRepository? @relation(fields: [trackedRepositoryId], references: [id], onDelete: SetNull)
  ingestionJob          IngestionJob? @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)
  observations          EvidenceObservation[]

  @@index([status, receivedAt])
  @@index([trackedRepositoryId, receivedAt])
  @@index([githubInstallationId, receivedAt])
  @@index([installationId, receivedAt])
}

model IngestionJob {
  id                    String @id @default(cuid())
  workspaceId           String
  trackedRepositoryId   String?
  githubInstallationId  String?
  kind                  IngestionJobKind
  status                IngestionJobStatus @default(PENDING)
  deduplicationKey      String
  minimalPayload        Json
  availableAt           DateTime @default(now())
  attemptCount          Int @default(0)
  maximumAttempts       Int @default(5)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  sanitizedLastErrorCode String?
  generation            Int @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository     TrackedRepository? @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  installation          GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  deliveries            WebhookDelivery[]

  @@index([status, availableAt])
  @@index([trackedRepositoryId, status])
  @@index([githubInstallationId, status])
  @@index([workspaceId, createdAt])
}

model EvidenceObservation {
  id                    String @id @default(cuid())
  repositoryEvidenceId  String
  sourceKind            ObservationSourceKind
  syncRunId             String?
  webhookDeliveryId     String?
  observedAt            DateTime
  normalizedContentHash String
  deduplicationKey      String @unique
  createdAt             DateTime @default(now())
  repositoryEvidence    RepositoryEvidence @relation(fields: [repositoryEvidenceId], references: [id], onDelete: Cascade)
  syncRun               RepositorySyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  webhookDelivery       WebhookDelivery? @relation(fields: [webhookDeliveryId], references: [id], onDelete: SetNull)

  @@index([repositoryEvidenceId, observedAt])
  @@index([webhookDeliveryId])
  @@index([syncRunId])
}

model RepositoryIngestionCursor {
  id                    String @id @default(cuid())
  trackedRepositoryId   String
  sourceKind            IngestionJobKind
  lastSuccessfulAt      DateTime?
  lastObservedSourceAt  DateTime?
  etag                  String?
  lastModified          String?
  schemaVersion         Int @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  trackedRepository     TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)

  @@unique([trackedRepositoryId, sourceKind])
  @@index([lastSuccessfulAt])
}

model EvidenceClaim {
  id                    String @id @default(cuid())
  workspaceId           String
  trackedRepositoryId   String
  authorUserId          String
  statement             String
  status                ClaimStatus @default(NEEDS_EVIDENCE)
  verifiedAt            DateTime?
  version               Int @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository     TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  author                User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  evidenceLinks         ClaimEvidence[]
  revisions             ClaimRevision[]

  @@index([workspaceId, trackedRepositoryId, status])
  @@index([authorUserId, updatedAt])
  @@unique([id, trackedRepositoryId])
}

model ClaimEvidence {
  claimId               String
  repositoryEvidenceId  String
  trackedRepositoryId   String
  linkedByUserId        String
  createdAt             DateTime @default(now())
  claim                 EvidenceClaim @relation(fields: [claimId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  repositoryEvidence    RepositoryEvidence @relation(fields: [repositoryEvidenceId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  linkedBy              User @relation(fields: [linkedByUserId], references: [id], onDelete: Cascade)

  @@id([claimId, repositoryEvidenceId])
  @@index([repositoryEvidenceId])
  @@index([linkedByUserId])
  @@index([trackedRepositoryId])
}

model ClaimRevision {
  id                    String @id @default(cuid())
  claimId               String
  actorUserId           String
  revisionNumber        Int
  kind                  ClaimRevisionKind
  statementSnapshot     String
  status                ClaimStatus
  evidenceIdSnapshot    String?
  changeSummary         String
  createdAt             DateTime @default(now())
  claim                 EvidenceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor                 User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([claimId, revisionNumber])
  @@index([actorUserId, createdAt])
}

model AuditEvent {
  id          String @id @default(cuid())
  workspaceId String?
  userId      String?
  type        String
  metadata    Json?
  createdAt   DateTime @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}
