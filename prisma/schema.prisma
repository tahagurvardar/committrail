generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum GitHubConnectionStage {
  INSTALLATION
  AUTHORIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

enum RepositorySource {
  PUBLIC
  INSTALLATION
}

enum TrackingStatus {
  ACTIVE
  INACCESSIBLE
  DISCONNECTED
}

enum SyncMode {
  INITIAL
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum WebhookDeliveryStatus {
  RECEIVED
  QUEUED
  IGNORED
  PROCESSED
  FAILED
}

enum IngestionJobKind {
  REPOSITORY_METADATA
  COMMITS
  PULL_REQUESTS
  ISSUES
  RELEASES
  WORKFLOW_RUNS
  INSTALLATION_STATE
  INSTALLATION_REPOSITORIES
  GROUNDED_DRAFT
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum ObservationSourceKind {
  MANUAL_SYNC
  WEBHOOK
}

enum EvidenceSourceAvailability {
  AVAILABLE
  UNAVAILABLE
  DELETED
}

enum ClaimStatus {
  DRAFT
  NEEDS_EVIDENCE
  VERIFIED
  ARCHIVED
}

enum ClaimRevisionKind {
  CREATED
  STATEMENT_EDITED
  STATUS_CHANGED
  EVIDENCE_LINKED
  EVIDENCE_UNLINKED
  VERIFIED
  ARCHIVED
  RESTORED
  DRAFT_ACCEPTED
  HUMAN_EDIT_AFTER_ACCEPTANCE
}

enum ClaimOrigin {
  HUMAN
  AI_ASSISTED
}

enum DraftProviderKind {
  OPENAI_COMPATIBLE
  FIXTURE
}

enum DraftProviderClassification {
  LOCAL
  EXTERNAL
}

enum DraftStyle {
  CONCISE
  TECHNICAL
  INTERVIEW
}

enum DraftGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DraftGroundingStatus {
  VALID
  INVALID
  STALE
}

enum DraftReviewStatus {
  READY
  ACCEPTED
  REJECTED
  SUPERSEDED
  INVALID
}

enum DraftReviewEventKind {
  GENERATION_QUEUED
  GENERATION_STARTED
  GENERATION_SUCCEEDED
  GENERATION_FAILED
  CANDIDATE_REJECTED
  CANDIDATE_ACCEPTED
  CLAIM_CREATED
  CLAIM_REPLACED
  HUMAN_EDITED
  CONSENT_GRANTED
  CONSENT_REVOKED
}

enum PublicProfileVisibility {
  PRIVATE
  PUBLIC
}

enum PublicSlugKind {
  PROFILE
  PROJECT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PublicationVisibility {
  PUBLIC
  UNLISTED
}

enum RepositoryDisclosurePolicy {
  PUBLIC_REPOSITORY
  IDENTITY_REDACTED
}

enum EvidenceDisclosureMode {
  PUBLIC_SOURCE
  SUMMARY_ONLY
  PRIVATE_SOURCE_REDACTED
}

enum PublicationEventKind {
  DRAFT_CREATED
  PREVIEWED
  PUBLISHED
  REVISION_PUBLISHED
  UNPUBLISHED
  REPUBLISHED
  ARCHIVED
  RESTORED
  VISIBILITY_CHANGED
  EVIDENCE_BECAME_STALE
  PROFILE_HIDDEN
  REPOSITORY_DISCONNECTED
  ACCOUNT_DELETED
}

enum PublicationHealthState {
  CURRENT
  REVIEW_REQUIRED
  SOURCE_UNAVAILABLE
}

enum PortfolioOutputType {
  CASE_STUDY
  CV_BULLETS
  INTERVIEW_STORY
}

enum PortfolioOutputStatus {
  DRAFT
  READY
  ARCHIVED
}

model User {
  id                       String                       @id
  name                     String
  email                    String                       @unique
  emailVerified            Boolean                      @default(false)
  image                    String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  ownedWorkspace           Workspace?                   @relation("WorkspaceOwner")
  memberships              WorkspaceMember[]
  connectionAttempts       GitHubConnectionAttempt[]
  initiatedSyncRuns        RepositorySyncRun[]
  auditEvents              AuditEvent[]
  authoredClaims           EvidenceClaim[]
  linkedClaimEvidence      ClaimEvidence[]
  claimRevisions           ClaimRevision[]
  acceptedDraftingConsents WorkspaceDraftingConsent[]
  draftGenerationRequests  DraftGenerationRequest[]
  draftReviewEvents        DraftReviewEvent[]
  reviewedDraftCandidates  DraftCandidate[]
  publishedRevisions       ProjectPublicationRevision[]
  publicationEvents        PublicationEvent[]
  portfolioOutputRevisions PortfolioOutputRevision[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id                      String                     @id @default(cuid())
  name                    String
  slug                    String                     @unique
  ownerUserId             String                     @unique
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  owner                   User                       @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members                 WorkspaceMember[]
  connectionAttempts      GitHubConnectionAttempt[]
  installations           GitHubInstallation[]
  trackedRepositories     TrackedRepository[]
  auditEvents             AuditEvent[]
  webhookDeliveries       WebhookDelivery[]
  ingestionJobs           IngestionJob[]
  evidenceClaims          EvidenceClaim[]
  draftingConsents        WorkspaceDraftingConsent[]
  draftGenerationRequests DraftGenerationRequest[]
  draftReviewEvents       DraftReviewEvent[]
  publicProfile           PublicProfile?
  projectPublications     ProjectPublication[]
  publicationEvents       PublicationEvent[]
  portfolioOutputs        PortfolioOutput[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model GitHubConnectionAttempt {
  id                    String                @id @default(cuid())
  workspaceId           String
  initiatingUserId      String
  stage                 GitHubConnectionStage
  stateHash             String                @unique
  encryptedPkceVerifier String?
  pendingInstallationId BigInt?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime              @default(now())
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiatingUser        User                  @relation(fields: [initiatingUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([initiatingUserId])
}

model GitHubInstallation {
  id                        String              @id @default(cuid())
  workspaceId               String
  installationId            BigInt              @unique
  accountId                 BigInt
  accountLogin              String
  accountType               String
  repositorySelection       RepositorySelection
  permissions               Json
  suspendedAt               DateTime?
  verifiedAt                DateTime
  lastRepositoryDiscoveryAt DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories              TrackedRepository[]
  webhookDeliveries         WebhookDelivery[]
  ingestionJobs             IngestionJob[]

  @@index([workspaceId])
}

model TrackedRepository {
  id                      String                      @id @default(cuid())
  workspaceId             String
  githubInstallationId    String?
  githubRepositoryId      BigInt
  ownerLogin              String
  name                    String
  fullName                String
  visibility              String
  defaultBranch           String
  archived                Boolean                     @default(false)
  fork                    Boolean                     @default(false)
  sourceType              RepositorySource
  trackingStatus          TrackingStatus              @default(ACTIVE)
  lastSuccessfulSyncAt    DateTime?
  latestSyncStatus        SyncStatus?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation            GitHubInstallation?         @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  snapshot                RepositorySnapshot?
  evidence                RepositoryEvidence[]
  syncRuns                RepositorySyncRun[]
  webhookDeliveries       WebhookDelivery[]
  ingestionJobs           IngestionJob[]
  ingestionCursors        RepositoryIngestionCursor[]
  evidenceClaims          EvidenceClaim[]
  draftGenerationRequests DraftGenerationRequest[]
  projectPublications     ProjectPublication[]
  portfolioOutputs        PortfolioOutput[]

  @@unique([workspaceId, githubRepositoryId])
  @@index([githubInstallationId])
}

model RepositorySnapshot {
  id                  String            @id @default(cuid())
  trackedRepositoryId String            @unique
  normalizedData      Json
  sourceUpdatedAt     DateTime
  sourcePushedAt      DateTime?
  fetchedAt           DateTime
  schemaVersion       Int               @default(1)
  trackedRepository   TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
}

model RepositoryEvidence {
  id                     String                          @id @default(cuid())
  trackedRepositoryId    String
  evidenceId             String
  evidenceType           String
  githubSourceId         String
  canonicalUrl           String
  occurredAt             DateTime
  title                  String
  sourceLabel            String                          @default("GitHub")
  confidence             String                          @default("fact")
  factualPayload         Json
  normalizedContentHash  String                          @default("")
  sourceAvailability     EvidenceSourceAvailability      @default(AVAILABLE)
  sourceUnavailableAt    DateTime?
  firstSeenAt            DateTime                        @default(now())
  lastSeenAt             DateTime                        @default(now())
  trackedRepository      TrackedRepository               @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  observations           EvidenceObservation[]
  claimLinks             ClaimEvidence[]
  draftSelections        DraftGenerationEvidence[]
  publicationDisclosures PublicationEvidenceDisclosure[]
  publicationSnapshots   PublicationEvidenceSnapshot[]

  @@unique([trackedRepositoryId, evidenceId])
  @@unique([id, trackedRepositoryId])
  @@index([trackedRepositoryId, occurredAt])
  @@index([trackedRepositoryId, evidenceType, sourceAvailability])
}

model RepositorySyncRun {
  id                  String                @id @default(cuid())
  trackedRepositoryId String
  initiatingUserId    String
  mode                SyncMode
  status              SyncStatus
  startedAt           DateTime              @default(now())
  completedAt         DateTime?
  sanitizedErrorCode  String?
  insertedCount       Int                   @default(0)
  updatedCount        Int                   @default(0)
  seenCount           Int                   @default(0)
  sectionAvailability Json?
  createdAt           DateTime              @default(now())
  trackedRepository   TrackedRepository     @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  initiatingUser      User                  @relation(fields: [initiatingUserId], references: [id], onDelete: Cascade)
  observations        EvidenceObservation[]

  @@index([trackedRepositoryId, status, createdAt])
  @@index([initiatingUserId])
}

model WebhookDelivery {
  id                   String                @id @default(cuid())
  githubDeliveryId     String                @unique
  workspaceId          String?
  githubInstallationId String?
  trackedRepositoryId  String?
  ingestionJobId       String?
  jobGeneration        Int                   @default(0)
  eventName            String
  action               String?
  installationId       BigInt?
  githubRepositoryId   BigInt?
  payloadSha256        String
  bodyByteCount        Int
  duplicateCount       Int                   @default(0)
  receivedAt           DateTime              @default(now())
  status               WebhookDeliveryStatus @default(RECEIVED)
  ignoredReason        String?
  processedAt          DateTime?
  sanitizedErrorCode   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation         GitHubInstallation?   @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  trackedRepository    TrackedRepository?    @relation(fields: [trackedRepositoryId], references: [id], onDelete: SetNull)
  ingestionJob         IngestionJob?         @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)
  observations         EvidenceObservation[]

  @@index([status, receivedAt])
  @@index([trackedRepositoryId, receivedAt])
  @@index([githubInstallationId, receivedAt])
  @@index([installationId, receivedAt])
}

model IngestionJob {
  id                     String                  @id @default(cuid())
  workspaceId            String
  trackedRepositoryId    String?
  githubInstallationId   String?
  kind                   IngestionJobKind
  status                 IngestionJobStatus      @default(PENDING)
  deduplicationKey       String
  minimalPayload         Json
  availableAt            DateTime                @default(now())
  attemptCount           Int                     @default(0)
  maximumAttempts        Int                     @default(5)
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  sanitizedLastErrorCode String?
  generation             Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository      TrackedRepository?      @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  installation           GitHubInstallation?     @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  deliveries             WebhookDelivery[]
  draftGenerationRequest DraftGenerationRequest?

  @@index([status, availableAt])
  @@index([trackedRepositoryId, status])
  @@index([githubInstallationId, status])
  @@index([workspaceId, createdAt])
}

model EvidenceObservation {
  id                    String                @id @default(cuid())
  repositoryEvidenceId  String
  sourceKind            ObservationSourceKind
  syncRunId             String?
  webhookDeliveryId     String?
  observedAt            DateTime
  normalizedContentHash String
  deduplicationKey      String                @unique
  createdAt             DateTime              @default(now())
  repositoryEvidence    RepositoryEvidence    @relation(fields: [repositoryEvidenceId], references: [id], onDelete: Cascade)
  syncRun               RepositorySyncRun?    @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  webhookDelivery       WebhookDelivery?      @relation(fields: [webhookDeliveryId], references: [id], onDelete: SetNull)

  @@index([repositoryEvidenceId, observedAt])
  @@index([webhookDeliveryId])
  @@index([syncRunId])
}

model RepositoryIngestionCursor {
  id                   String            @id @default(cuid())
  trackedRepositoryId  String
  sourceKind           IngestionJobKind
  lastSuccessfulAt     DateTime?
  lastObservedSourceAt DateTime?
  etag                 String?
  lastModified         String?
  schemaVersion        Int               @default(1)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  trackedRepository    TrackedRepository @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)

  @@unique([trackedRepositoryId, sourceKind])
  @@index([lastSuccessfulAt])
}

model EvidenceClaim {
  id                         String                      @id @default(cuid())
  workspaceId                String
  trackedRepositoryId        String
  authorUserId               String
  statement                  String
  status                     ClaimStatus                 @default(NEEDS_EVIDENCE)
  origin                     ClaimOrigin                 @default(HUMAN)
  humanEditedAfterAcceptance Boolean                     @default(false)
  verifiedAt                 DateTime?
  version                    Int                         @default(1)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository          TrackedRepository           @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  author                     User                        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  evidenceLinks              ClaimEvidence[]
  revisions                  ClaimRevision[]
  sourceCandidate            DraftCandidate?             @relation("AcceptedCandidateClaim")
  draftReviewEvents          DraftReviewEvent[]
  publicationSelections      PublicationClaimSelection[]
  publicationSnapshots       PublicationClaimSnapshot[]
  portfolioSelections        PortfolioOutputClaim[]

  @@unique([id, trackedRepositoryId])
  @@index([workspaceId, trackedRepositoryId, status])
  @@index([authorUserId, updatedAt])
}

model ClaimEvidence {
  claimId              String
  repositoryEvidenceId String
  trackedRepositoryId  String
  linkedByUserId       String
  createdAt            DateTime           @default(now())
  claim                EvidenceClaim      @relation(fields: [claimId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  repositoryEvidence   RepositoryEvidence @relation(fields: [repositoryEvidenceId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  linkedBy             User               @relation(fields: [linkedByUserId], references: [id], onDelete: Cascade)

  @@id([claimId, repositoryEvidenceId])
  @@index([repositoryEvidenceId])
  @@index([linkedByUserId])
  @@index([trackedRepositoryId])
}

model ClaimRevision {
  id                 String            @id @default(cuid())
  claimId            String
  actorUserId        String
  revisionNumber     Int
  kind               ClaimRevisionKind
  statementSnapshot  String
  status             ClaimStatus
  evidenceIdSnapshot String?
  changeSummary      String
  createdAt          DateTime          @default(now())
  claim              EvidenceClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor              User              @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([claimId, revisionNumber])
  @@index([actorUserId, createdAt])
}

model AuditEvent {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  type        String
  metadata    Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model WorkspaceDraftingConsent {
  id                     String                      @id @default(cuid())
  workspaceId            String
  consentVersion         Int
  privacyPolicyVersion   Int
  providerKind           DraftProviderKind
  providerClassification DraftProviderClassification
  providerIdentityHash   String
  acceptedByUserId       String
  acceptedAt             DateTime                    @default(now())
  revokedAt              DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  workspace              Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  acceptedBy             User                        @relation(fields: [acceptedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, consentVersion, privacyPolicyVersion, providerKind, providerClassification, providerIdentityHash], map: "WorkspaceDraftingConsent_workspaceId_consentVersion_privacy_idx")
  @@index([workspaceId, revokedAt, acceptedAt])
  @@index([acceptedByUserId, acceptedAt])
}

model DraftGenerationRequest {
  id                     String                      @id @default(cuid())
  workspaceId            String
  trackedRepositoryId    String
  requestedByUserId      String
  ingestionJobId         String?                     @unique
  regenerationOfId       String?
  providerKind           DraftProviderKind
  providerClassification DraftProviderClassification
  providerIdentityHash   String
  modelLabel             String
  promptTemplateVersion  Int
  evidenceBundleVersion  Int
  evidenceBundleHash     String
  draftingIntent         String
  style                  DraftStyle
  status                 DraftGenerationStatus       @default(QUEUED)
  requestHash            String
  queuedAt               DateTime                    @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  sanitizedErrorCode     String?
  inputEvidenceCount     Int
  inputByteCount         Int
  outputByteCount        Int?
  requestDurationMs      Int?
  inputTokenCount        Int?
  outputTokenCount       Int?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  workspace              Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository      TrackedRepository           @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  requestedBy            User                        @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  ingestionJob           IngestionJob?               @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)
  regenerationOf         DraftGenerationRequest?     @relation("DraftRegeneration", fields: [regenerationOfId], references: [id], onDelete: SetNull)
  regenerations          DraftGenerationRequest[]    @relation("DraftRegeneration")
  evidenceSelections     DraftGenerationEvidence[]
  candidate              DraftCandidate?
  reviewEvents           DraftReviewEvent[]

  @@unique([id, trackedRepositoryId])
  @@index([workspaceId, trackedRepositoryId, status, createdAt])
  @@index([workspaceId, requestedByUserId, createdAt])
  @@index([requestHash, status])
  @@index([ingestionJobId])
}

model DraftGenerationEvidence {
  draftRequestId       String
  repositoryEvidenceId String
  trackedRepositoryId  String
  evidenceContentHash  String
  position             Int
  createdAt            DateTime                @default(now())
  draftRequest         DraftGenerationRequest  @relation(fields: [draftRequestId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  repositoryEvidence   RepositoryEvidence      @relation(fields: [repositoryEvidenceId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  sentenceCitations    DraftSentenceEvidence[]

  @@id([draftRequestId, repositoryEvidenceId, trackedRepositoryId])
  @@unique([draftRequestId, position])
  @@index([repositoryEvidenceId])
  @@index([trackedRepositoryId])
}

model DraftCandidate {
  id                          String                 @id @default(cuid())
  requestId                   String                 @unique
  candidateVersion            Int                    @default(1)
  title                       String?
  combinedStatement           String
  caveats                     Json
  policyWarnings              Json
  confidence                  String                 @default("AI_ASSISTED_DRAFT")
  groundingStatus             DraftGroundingStatus   @default(VALID)
  reviewStatus                DraftReviewStatus      @default(READY)
  sentenceCount               Int
  citedSentenceCount          Int
  uniqueEvidenceCount         Int
  selectedEvidenceCount       Int
  evidenceTypesUsed           Json
  unusedSelectedEvidenceCount Int
  acceptedClaimId             String?                @unique
  reviewedByUserId            String?
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  rejectionReason             String?
  createdAt                   DateTime               @default(now())
  request                     DraftGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  acceptedClaim               EvidenceClaim?         @relation("AcceptedCandidateClaim", fields: [acceptedClaimId], references: [id], onDelete: SetNull)
  reviewedBy                  User?                  @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  sentences                   DraftSentence[]
  reviewEvents                DraftReviewEvent[]

  @@unique([id, requestId])
  @@index([reviewStatus, createdAt])
  @@index([groundingStatus, createdAt])
}

model DraftSentence {
  id             String                  @id @default(cuid())
  candidateId    String
  draftRequestId String
  position       Int
  text           String
  createdAt      DateTime                @default(now())
  candidate      DraftCandidate          @relation(fields: [candidateId, draftRequestId], references: [id, requestId], onDelete: Cascade)
  citations      DraftSentenceEvidence[]

  @@unique([candidateId, position])
  @@unique([id, draftRequestId])
  @@index([draftRequestId])
}

model DraftSentenceEvidence {
  draftSentenceId      String
  draftRequestId       String
  repositoryEvidenceId String
  trackedRepositoryId  String
  position             Int
  createdAt            DateTime                @default(now())
  draftSentence        DraftSentence           @relation(fields: [draftSentenceId, draftRequestId], references: [id, draftRequestId], onDelete: Cascade)
  selectedEvidence     DraftGenerationEvidence @relation(fields: [draftRequestId, repositoryEvidenceId, trackedRepositoryId], references: [draftRequestId, repositoryEvidenceId, trackedRepositoryId], onDelete: Cascade)

  @@id([draftSentenceId, repositoryEvidenceId])
  @@unique([draftSentenceId, position])
  @@index([draftRequestId, repositoryEvidenceId, trackedRepositoryId])
}

model DraftReviewEvent {
  id             String                  @id @default(cuid())
  workspaceId    String
  draftRequestId String?
  candidateId    String?
  claimId        String?
  actorUserId    String?
  kind           DraftReviewEventKind
  metadata       Json?
  createdAt      DateTime                @default(now())
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  draftRequest   DraftGenerationRequest? @relation(fields: [draftRequestId], references: [id], onDelete: Cascade)
  candidate      DraftCandidate?         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  claim          EvidenceClaim?          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor          User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([draftRequestId, createdAt])
  @@index([candidateId, createdAt])
  @@index([claimId, createdAt])
  @@index([actorUserId, createdAt])
}

model PublicProfile {
  id                 String                  @id @default(cuid())
  workspaceId        String                  @unique
  slug               String                  @unique
  displayName        String
  headline           String
  biography          String
  locationText       String?
  personalWebsiteUrl String?
  githubProfileUrl   String?
  visibility         PublicProfileVisibility @default(PRIVATE)
  firstPublishedAt   DateTime?
  latestPublishedAt  DateTime?
  version            Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publications       ProjectPublication[]

  @@index([visibility, latestPublishedAt])
}

model PublicSlugReservation {
  id                      String         @id @default(cuid())
  slug                    String         @unique
  kind                    PublicSlugKind
  reservedByWorkspaceHash String
  firstReservedAt         DateTime       @default(now())

  @@index([kind, firstReservedAt])
}

model ProjectPublication {
  id                         String                          @id @default(cuid())
  workspaceId                String
  trackedRepositoryId        String
  profileId                  String
  slug                       String                          @unique
  internalTitle              String
  title                      String
  summary                    String
  roleText                   String
  projectPeriodText          String?
  technologyLabels           String[]                        @default([])
  problemText                String?
  approachText               String?
  outcomeText                String?
  repositoryDisclosurePolicy RepositoryDisclosurePolicy
  status                     PublicationStatus               @default(DRAFT)
  visibility                 PublicationVisibility           @default(UNLISTED)
  currentPublishedRevisionId String?                         @unique
  lastPublishIdempotencyKey  String?                         @unique
  firstPublishedAt           DateTime?
  latestPublishedAt          DateTime?
  unpublishedAt              DateTime?
  archivedAt                 DateTime?
  healthState                PublicationHealthState          @default(CURRENT)
  healthCheckedAt            DateTime?
  version                    Int                             @default(1)
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  workspace                  Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository          TrackedRepository               @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  profile                    PublicProfile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  currentPublishedRevision   ProjectPublicationRevision?     @relation("CurrentPublicationRevision", fields: [currentPublishedRevisionId], references: [id], onDelete: SetNull)
  revisions                  ProjectPublicationRevision[]    @relation("PublicationRevisions")
  claimSelections            PublicationClaimSelection[]
  evidenceDisclosures        PublicationEvidenceDisclosure[]
  events                     PublicationEvent[]

  @@unique([id, trackedRepositoryId])
  @@index([workspaceId, status, updatedAt])
  @@index([profileId, status, visibility, latestPublishedAt])
  @@index([status, visibility, latestPublishedAt])
  @@index([trackedRepositoryId, healthState])
}

model PublicationClaimSelection {
  publicationId         String
  claimId               String
  trackedRepositoryId   String
  position              Int
  selectedStatementHash String
  createdAt             DateTime                        @default(now())
  publication           ProjectPublication              @relation(fields: [publicationId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  claim                 EvidenceClaim                   @relation(fields: [claimId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  evidenceDisclosures   PublicationEvidenceDisclosure[]

  @@id([publicationId, claimId])
  @@unique([publicationId, position])
  @@index([claimId])
  @@index([trackedRepositoryId])
}

model PublicationEvidenceDisclosure {
  publicationId        String
  claimId              String
  repositoryEvidenceId String
  trackedRepositoryId  String
  position             Int
  mode                 EvidenceDisclosureMode
  publicTitle          String?
  includeOccurredAt    Boolean                   @default(true)
  sourceContentHash    String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  publication          ProjectPublication        @relation(fields: [publicationId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  claimSelection       PublicationClaimSelection @relation(fields: [publicationId, claimId], references: [publicationId, claimId], onDelete: Cascade)
  repositoryEvidence   RepositoryEvidence        @relation(fields: [repositoryEvidenceId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)

  @@id([publicationId, claimId, repositoryEvidenceId])
  @@unique([publicationId, claimId, position])
  @@index([repositoryEvidenceId])
  @@index([trackedRepositoryId])
}

model ProjectPublicationRevision {
  id                         String                        @id @default(cuid())
  publicationId              String
  revisionNumber             Int
  title                      String
  summary                    String
  roleText                   String
  projectPeriodText          String?
  technologyLabels           String[]                      @default([])
  problemText                String?
  approachText               String?
  outcomeText                String?
  repositoryDisclosurePolicy RepositoryDisclosurePolicy
  publicRepositoryLabel      String?
  publicRepositoryUrl        String?
  authorSlug                 String
  authorDisplayName          String
  authorHeadline             String
  authorBiography            String
  authorLocationText         String?
  authorPersonalWebsiteUrl   String?
  authorGithubProfileUrl     String?
  visibility                 PublicationVisibility
  publishedByUserId          String
  publishedAt                DateTime                      @default(now())
  contentHash                String
  schemaVersion              Int                           @default(1)
  supersededAt               DateTime?
  createdAt                  DateTime                      @default(now())
  publication                ProjectPublication            @relation("PublicationRevisions", fields: [publicationId], references: [id], onDelete: Cascade)
  currentForPublication      ProjectPublication?           @relation("CurrentPublicationRevision")
  publishedBy                User                          @relation(fields: [publishedByUserId], references: [id], onDelete: Restrict)
  claimSnapshots             PublicationClaimSnapshot[]
  evidenceSnapshots          PublicationEvidenceSnapshot[]

  @@unique([publicationId, revisionNumber])
  @@index([publicationId, publishedAt])
  @@index([visibility, publishedAt])
  @@index([publishedByUserId, publishedAt])
}

model PublicationClaimSnapshot {
  id                    String                        @id @default(cuid())
  publicationRevisionId String
  sourceClaimId         String
  publicClaimIdentifier String
  position              Int
  statement             String
  statementHash         String
  claimOrigin           ClaimOrigin
  verifiedAt            DateTime
  humanEdited           Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  publicationRevision   ProjectPublicationRevision    @relation(fields: [publicationRevisionId], references: [id], onDelete: Cascade)
  sourceClaim           EvidenceClaim                 @relation(fields: [sourceClaimId], references: [id], onDelete: Restrict)
  evidenceSnapshots     PublicationEvidenceSnapshot[]

  @@unique([publicationRevisionId, position])
  @@unique([publicationRevisionId, publicClaimIdentifier])
  @@index([sourceClaimId])
}

model PublicationEvidenceSnapshot {
  id                         String                     @id @default(cuid())
  publicationRevisionId      String
  publicationClaimSnapshotId String
  sourceRepositoryEvidenceId String
  publicDisclosureIdentifier String
  position                   Int
  evidenceType               String
  publicTitle                String
  occurredAt                 DateTime?
  disclosureMode             EvidenceDisclosureMode
  canonicalPublicSourceUrl   String?
  sourceVisibility           String
  publicProvenanceText       String
  confidence                 String                     @default("FACT")
  sourceContentHash          String
  contentHash                String
  createdAt                  DateTime                   @default(now())
  publicationRevision        ProjectPublicationRevision @relation(fields: [publicationRevisionId], references: [id], onDelete: Cascade)
  publicationClaimSnapshot   PublicationClaimSnapshot   @relation(fields: [publicationClaimSnapshotId], references: [id], onDelete: Cascade)
  sourceRepositoryEvidence   RepositoryEvidence         @relation(fields: [sourceRepositoryEvidenceId], references: [id], onDelete: Restrict)

  @@unique([publicationClaimSnapshotId, position])
  @@unique([publicationRevisionId, publicDisclosureIdentifier])
  @@index([publicationRevisionId])
  @@index([sourceRepositoryEvidenceId])
}

model PublicationEvent {
  id            String               @id @default(cuid())
  workspaceId   String
  publicationId String?
  actorUserId   String?
  kind          PublicationEventKind
  safeMetadata  Json?
  createdAt     DateTime             @default(now())
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publication   ProjectPublication?  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  actor         User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([publicationId, createdAt])
  @@index([actorUserId, createdAt])
}

model PortfolioOutput {
  id                  String                    @id @default(cuid())
  workspaceId         String
  trackedRepositoryId String
  type                PortfolioOutputType
  title               String
  status              PortfolioOutputStatus     @default(DRAFT)
  draftFields         Json
  currentRevisionId   String?                   @unique
  archivedAt          DateTime?
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedRepository   TrackedRepository         @relation(fields: [trackedRepositoryId], references: [id], onDelete: Cascade)
  currentRevision     PortfolioOutputRevision?  @relation("CurrentPortfolioOutputRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions           PortfolioOutputRevision[] @relation("PortfolioOutputRevisions")
  claimSelections     PortfolioOutputClaim[]

  @@unique([id, trackedRepositoryId])
  @@index([workspaceId, status, updatedAt])
  @@index([trackedRepositoryId, type])
}

model PortfolioOutputClaim {
  outputId            String
  claimId             String
  trackedRepositoryId String
  position            Int
  statementOverride   String?
  createdAt           DateTime        @default(now())
  output              PortfolioOutput @relation(fields: [outputId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Cascade)
  claim               EvidenceClaim   @relation(fields: [claimId, trackedRepositoryId], references: [id, trackedRepositoryId], onDelete: Restrict)

  @@id([outputId, claimId])
  @@unique([outputId, position])
  @@index([claimId])
  @@index([trackedRepositoryId])
}

model PortfolioOutputRevision {
  id                String           @id @default(cuid())
  outputId          String
  revisionNumber    Int
  templateVersion   Int              @default(1)
  claimSnapshots    Json
  userFields        Json
  structuredContent Json
  renderedText      String
  renderedMarkdown  String
  contentHash       String
  createdByUserId   String
  createdAt         DateTime         @default(now())
  output            PortfolioOutput  @relation("PortfolioOutputRevisions", fields: [outputId], references: [id], onDelete: Cascade)
  currentForOutput  PortfolioOutput? @relation("CurrentPortfolioOutputRevision")
  createdBy         User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([outputId, revisionNumber])
  @@index([createdByUserId, createdAt])
}
