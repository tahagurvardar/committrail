# CommitTrail local environment. Never commit real secrets.

# PostgreSQL 17: development and test must be distinct.
DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail
TEST_DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail_test

# Better Auth and local encryption.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Optional token for the account-free public explorer only.
# GITHUB_TOKEN=

# Read-only GitHub App. Leave blank when using only the public explorer.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# PEM with literal \n line breaks.
GITHUB_APP_PRIVATE_KEY=

# Phase 3 webhook HMAC secret. Use a unique high-entropy value of at least
# 32 bytes. It is validated lazily and is never stored, rendered, or logged.
GITHUB_WEBHOOK_SECRET=
