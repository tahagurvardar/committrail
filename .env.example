# CommitTrail environment variables
#
# Phase 0 requires NO environment variables. The application builds, tests,
# and runs without any of the entries below. Never commit a real .env file.
#
# The names below are reserved for later phases and are NOT read by the code
# today. They are kept commented out so nothing appears required.

# --- Phase 2+ · Database (reserved, inactive) --------------------------------
# DATABASE_URL=

# --- Phase 2+ · Authentication (reserved, inactive) --------------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# --- Phase 2+ · GitHub App, read-only (reserved, inactive) -------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# --- Phase 4+ · Grounded drafting provider (reserved, inactive) --------------
# AI_PROVIDER_API_KEY=
