# CommitTrail local environment. Never commit real secrets.

# `full` enables the database-backed product. `public-demo` is database-free
# and blocks account/workspace/data mutation surfaces.
APP_MODE=full

# PostgreSQL 17: development and test must be distinct.
DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail
TEST_DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail_test

# Better Auth and local encryption.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Optional token for the account-free public explorer only.
# GITHUB_TOKEN=

# Read-only GitHub App. Leave blank when using only the public explorer.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# PEM with literal \n line breaks.
GITHUB_APP_PRIVATE_KEY=

# Phase 3 webhook HMAC secret. Use a unique high-entropy value of at least
# 32 bytes. It is validated lazily and is never stored, rendered, or logged.
GITHUB_WEBHOOK_SECRET=

# Phase 4 private grounded drafting is disabled by default and requires no
# paid API. "openai-compatible" may target a loopback local service or an HTTPS
# external service. These values are server-owned and must never be rendered.
DRAFT_PROVIDER=disabled
DRAFT_PROVIDER_BASE_URL=
DRAFT_PROVIDER_API_KEY=
DRAFT_PROVIDER_MODEL=
DRAFT_PROVIDER_TIMEOUT_MS=30000
DRAFT_PROVIDER_MAX_INPUT_BYTES=65536
DRAFT_PROVIDER_MAX_OUTPUT_BYTES=16384
# Optional canonical origin for public profile/project metadata and sitemap.
# Must be an HTTPS public origin without credentials, query, or fragment.
PUBLIC_APP_URL=

# Test-only. Playwright sets this for its disposable `.example.test` fixtures.
# Never enable in production; startup validation rejects that combination.
# E2E_FIXTURES=1
