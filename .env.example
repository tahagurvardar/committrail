# CommitTrail environment variables
#
# Phase 1B requires NO environment variables — the application builds, tests,
# and runs without any of the entries below. Never commit a real .env file.

# --- Phase 1 · Optional GitHub token (active, optional) ----------------------
# Server-only. When set, public snapshot and activity requests to GitHub REST are
# authenticated, which raises the rate limit. When unset, CommitTrail uses
# GitHub's anonymous public-data access. The token is never sent to the
# browser, never logged, never stored, and never required. Use a fine-grained
# token with NO scopes (public read only). Do not put a value in this file.
# GITHUB_TOKEN=

# --- Phase 2+ · Database (reserved, inactive) --------------------------------
# DATABASE_URL=

# --- Phase 2+ · Authentication (reserved, inactive) --------------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# --- Phase 2+ · GitHub App, read-only (reserved, inactive) -------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# --- Phase 4+ · Grounded drafting provider (reserved, inactive) --------------
# AI_PROVIDER_API_KEY=
# Phase 2 identity and persistence. Use local, non-production values only.
DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail
TEST_DATABASE_URL=postgresql://committrail:committrail@localhost:5432/committrail_test
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Optional GitHub App connection. Public exploration works without these.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Canonical format: a PEM value with literal \n line breaks.
GITHUB_APP_PRIVATE_KEY=
